{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			// git submodules, each with their own lint setup
			"!domain",
			// generated by `yarn types` (typechain)
			"!packages/fasset-indexer-core/chain",
			"!**/playground*.ts"
		]
	},
	// Formatting is left to the editor; Biome is used purely as a linter here,
	// matching what the ESLint setup it replaced did.
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				// `!` is deliberate throughout (~73 sites) and TypeScript already
				// checks these; the rule is pure preference for this codebase.
				"noNonNullAssertion": "off",
				// DO NOT ENABLE. tsconfig sets `emitDecoratorMetadata`, and NestJS
				// resolves constructor dependencies from the `design:paramtypes`
				// metadata TypeScript emits. `import type` erases that metadata, so
				// applying this rule builds and typechecks fine but breaks dependency
				// injection at runtime ("Nest can't resolve dependencies of the
				// XController (?)"). Same hazard applies to MikroORM entity decorators.
				"useImportType": "off"
			},
			"complexity": {
				// Tests reach private members via `fx['em']`, a deliberate TypeScript
				// escape hatch. This rule's fix (`fx.em`) does not compile.
				"useLiteralKeys": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/*/test/**/*.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						// tests stub and poke at internals
						"noExplicitAny": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"parser": {
			// NestJS controllers use parameter decorators (@Param, @Query, ...)
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
