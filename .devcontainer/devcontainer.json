// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-compose
// git ssh: https://code.visualstudio.com/remote/advancedcontainers/sharing-git-credentials
{
	"name": "FAsset Indexer Container",
    "dockerComposeFile": "compose.yaml",
    "service": "app",
    "workspaceFolder": "/workspaces/fasset-indexer",
    "remoteUser": "node",
    // Stop postgres with the workspace container rather than leaving it running.
    "shutdownAction": "stopCompose",
    // Bind mounts moved to compose.yaml: "mounts" is only honoured for
    // image/Dockerfile devcontainers, not compose ones. This still runs on the
    // host, so the paths exist before docker binds them.
    "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude && touch ${localEnv:HOME}/.claude.json",
    "postCreateCommand": "npm install -g @anthropic-ai/claude-code",
    // Reach the test database from host tools (psql, a GUI client).
    "forwardPorts": ["db:5432"],
    "customizations": {
        "vscode": {
            "extensions": [
                "mikestead.dotenv",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "eamodio.gitlens",
                "usernamehw.errorlens",
                "ms-azuretools.vscode-docker",
                "christian-kohler.path-intellisense",
                "wayou.vscode-todo-highlight",
                "pkief.material-icon-theme",
                "anthropic.claude-code"
            ],
            "settings": {
                "[typescript]": {
                    "editor.defaultFormatter": "vscode.typescript-language-features",
                    "editor.tabSize": 2
                },
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "files.trimFinalNewlines": true,
                "files.trimTrailingWhitespace": true
            }
        }
    }
}
